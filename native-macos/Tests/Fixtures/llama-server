#!/usr/bin/env python3
"""Local fault-injection fixture; never reads a model or connects to the internet."""
import argparse
import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("--host", default="127.0.0.1")
parser.add_argument("--port", type=int, required=True)
args, _ = parser.parse_known_args()
state = Path(os.environ["PANDAPLAYER_TRANSLATION_TEST_DIR"])
log = state / "requests.jsonl"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def respond(self, value):
        data = json.dumps(value, ensure_ascii=False).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.respond({"status": "ok"})

    def do_POST(self):
        payload = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        request = json.loads(payload["messages"][-1]["content"])
        history = [json.loads(line) for line in log.read_text().splitlines()] if log.exists() else []
        with log.open("a") as file:
            file.write(json.dumps(request) + "\n")
        lines = request["lines"]
        results = {}
        malformed = False
        for line in reversed(lines):
            text = line["text"]
            attempts = 1 + sum(any(item["text"] == text for item in row["lines"]) for row in history)
            if text == "Permanent failure" and not (state / "allow-retry").exists():
                results[line["id"]] = "用户提供了一些额外的信息，我将根据这些信息进行翻译。"
            elif text == "First" and attempts == 1:
                results[line["id"]] = "以下是翻译结果：第一句。"
            elif text == "Retry twice" and attempts < 3:
                # Deliberately omit one key, violating the required schema.
                continue
            elif text == "Malformed batch" and attempts < 3:
                malformed = True
            else:
                results[line["id"]] = {"First": "第一句", "Retry twice": "重试两次", "Permanent failure": "永久失败", "Fourth": "第四句", "Malformed batch": "第五句", "Last": "最后一句"}[text]
        content = '{"translations":{' if malformed else json.dumps({"translations": results}, ensure_ascii=False)
        self.respond({"choices": [{"message": {"content": content}, "finish_reason": "length" if malformed else "stop"}]})


ThreadingHTTPServer((args.host, args.port), Handler).serve_forever()
